    {
      "id": "matrix-08-commission-contribution",
      "source_row": 8,
      "phase": "execute",
      "request": "计算一个虚构佣金达人的单位经济。达人不采购商品，商品售价185元，每单确认佣金37元，达人承担的每单成本11元。没有其他成本资料。输出JSON对象，字段为revenue（达人每单收入）、contribution（每单贡献）、metric_name（该利润指标的中文名称）、limitations（说明数组）。",
      "context_keys": [
        "an-04",
        "wr-13"
      ],
      "checks": [
        {
          "name": "commission-is-revenue",
          "op": "json_close",
          "path": "revenue",
          "value": 37,
          "tolerance": 0.000001
        },
        {
          "name": "unit-contribution",
          "op": "json_close",
          "path": "contribution",
          "value": 26,
          "tolerance": 0.000001
        },
        {
          "name": "contribution-label",
          "op": "text_any",
          "patterns": [
            "贡献"
          ]
        }
      ],
      "requires_human_review": true
    },
    {
